# ── Database ─────────────────────────────────────────────────────
POSTGRES_USER=odrm
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=odrm

# ── JWT ──────────────────────────────────────────────────────────
# MUST be at least 32 characters and unique per deployment.
ODRM_JWT_SECRET=change-me-minimum-32-character-random-secret-key

# ── Environment ──────────────────────────────────────────────────
ODRM_ENV=production
ODRM_LOG_LEVEL=INFO
ODRM_CORS_ORIGINS=http://localhost:3000
ODRM_AUTH_COOKIE_SECURE=false
ODRM_RATE_LIMIT_ENABLED=true

# ── LLM Provider ─────────────────────────────────────────────────
ODRM_LLM_PROVIDER=gemini
ODRM_LLM_MODEL=gemini-2.5-flash
ODRM_LLM_API_KEY=
ODRM_LLM_BASE_URL=

# ── Frontend ─────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1