ODRM_ENV=local
ODRM_LOG_LEVEL=INFO
ODRM_API_PREFIX=/api/v1
ODRM_CORS_ORIGINS=http://localhost:3000
ODRM_MODEL_DIR=./models
ODRM_DATA_DIR=./data
ODRM_MAX_TEMPERATURE_C=1000

# Screening assistant provider (openai | ollama | gemini).
ODRM_LLM_PROVIDER=openai
ODRM_LLM_MODEL=gpt-4o-mini
ODRM_LLM_API_KEY=
# Optional provider or proxy override; Ollama uses http://localhost:11434/v1.
ODRM_LLM_BASE_URL=
ODRM_LLM_TEMPERATURE=0.0
ODRM_LLM_TIMEOUT_SECONDS=30
ODRM_CHAT_MAX_MESSAGE_CHARS=2000

# Internal TEA endpoint used by the chat tool.
ODRM_TEA_API_BASE_URL=http://127.0.0.1:8000/api/v1
ODRM_TEA_TIMEOUT_SECONDS=30
